# --- Обязательное ---

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Ваш Telegram ID (можно несколько через запятую).
# Бот работает на вашей личной подписке, поэтому отвечает только этим людям.
# Узнать свой ID: запустите бота и отправьте ему /id
JARVIS_OWNER_IDS=123456789


# --- Необязательное ---

# Песочница, в которой Jarvis работает с файлами
JARVIS_WORKSPACE=./workspace

# Модель. Пусто = та, что стоит по умолчанию в вашем Claude Code
# JARVIS_MODEL=claude-opus-5

# Режим разрешений: default | acceptEdits | plan | dontAsk | bypassPermissions | auto
# У бота нет способа спросить подтверждение, поэтому default здесь бесполезен.
JARVIS_PERMISSION_MODE=acceptEdits

# Инструменты, которые разрешены без подтверждения.
# Bash намеренно не включён — добавьте, только если понимаете риск.
JARVIS_ALLOWED_TOOLS=Read,Write,Edit,Glob,Grep,WebSearch,WebFetch

# Показывать в ответе, какими инструментами Jarvis пользовался (1/0)
JARVIS_SHOW_TOOLS=1

# Предохранители на один запрос
# JARVIS_MAX_TURNS=30
# JARVIS_MAX_BUDGET_USD=1.5

# ВАЖНО: не задавайте здесь ANTHROPIC_API_KEY — с ним запросы пойдут
# по API-ключу с оплатой за токены, а не по вашей подписке.
