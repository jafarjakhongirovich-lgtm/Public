# --- Обязательное ---

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Ваш Telegram ID (можно несколько через запятую).
# Бот работает на вашей личной подписке, поэтому отвечает только этим людям.
JARVIS_OWNER_IDS=123456789


# --- Память ---

# 0 = помнить разговор бессрочно (по умолчанию).
# Число = забывать через столько дней. /new стирает вручную в любой момент.
JARVIS_MEMORY_DAYS=0


# --- Голосовые сообщения ---

# Модель распознавания речи. Работает локально, интернет и ключи не нужны.
# tiny и base — быстрые и неточные, small — разумный баланс,
# medium и large-v3 — точнее, но заметно медленнее и тяжелее.
# Пусто = голосовые не распознавать.
JARVIS_WHISPER_MODEL=small


# --- Голосовые ответы ---

# Голос, которым Jarvis озвучивает ответы. Бесплатно, без ключей.
# ru-RU-DmitryNeural — мужской, ru-RU-SvetlanaNeural — женский.
# Пусто = отвечать только текстом.
JARVIS_TTS_VOICE=ru-RU-DmitryNeural

# Сколько символов ответа озвучивать. Остальное остаётся текстом.
JARVIS_TTS_MAX_CHARS=700


# --- Доступ к компьютеру ---

# Папки, в которые Jarvis может заходить помимо песочницы.
# Несколько — через точку с запятой. Пусто = только песочница.
# Пример: JARVIS_EXTRA_DIRS=%USERPROFILE%\Documents;%USERPROFILE%\Downloads
JARVIS_EXTRA_DIRS=


# --- Файлы ---

# Песочница, в которой Jarvis работает с файлами.
# Всё, что он там сохранит, отправляется в чат. Кроме подпапок tmp и inbox
# (в inbox складывается то, что вы прислали сами).
JARVIS_WORKSPACE=./workspace

# Сколько файлов максимум отправлять за один ответ
JARVIS_MAX_FILES=5


# --- Прочее ---

# Модель. Пусто = та, что стоит по умолчанию в вашем Claude Code
# JARVIS_MODEL=claude-opus-5

# Режим разрешений: default | acceptEdits | plan | dontAsk | bypassPermissions | auto
# У бота нет способа спросить подтверждение, поэтому default здесь бесполезен.
JARVIS_PERMISSION_MODE=acceptEdits

# Инструменты, доступные боту без подтверждения.
# Bash нужен для презентаций, таблиц и документов: Claude собирает их
# python-скриптами. Уберите Bash из списка, если такая возможность не нужна.
JARVIS_ALLOWED_TOOLS=Read,Write,Edit,Glob,Grep,Bash,WebSearch,WebFetch

# Показывать в ответе, какими инструментами Jarvis пользовался (1/0)
JARVIS_SHOW_TOOLS=1

# Предохранители на один запрос
# JARVIS_MAX_TURNS=30
# JARVIS_MAX_BUDGET_USD=1.5

# ВАЖНО: не задавайте здесь ANTHROPIC_API_KEY — с ним запросы пойдут
# по API-ключу с оплатой за токены, а не по вашей подписке.
