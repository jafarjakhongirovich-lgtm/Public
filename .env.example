# ---- Asosiy ----
# QR tokenlarini imzolash uchun maxfiy kalit. MAJBURIY o'zgartiring!
# Yaratish: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-please-use-a-long-random-string

# Baza. SQLite (start uchun) yoki PostgreSQL.
DATABASE_URL=sqlite:///./tabel.db
# DATABASE_URL=postgresql+psycopg://tabel:parol@db:5432/tabel

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# ---- Telegram bot ----
# @BotFather dan olinadi
BOT_TOKEN=
# Bot username (@ belgisiz). QR havolasi shu bo'yicha yasaladi: https://t.me/<BOT_USERNAME>?start=<token>
BOT_USERNAME=
# Kunlik hisobot yuboriladigan guruh (ixtiyoriy). Bo'sh bo'lsa yuborilmaydi.
REPORT_CHAT_ID=

# ---- QR xavfsizligi ----
# QR necha sekundda yangilanadi (ekranda)
QR_REFRESH_SECONDS=15
# Token necha sekund amal qiladi. Kichik bo'lsa xavfsizroq, lekin skaner ulgurmasligi mumkin.
QR_TTL_SECONDS=25

# ---- Admin panel ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- Internetga chiqarish (deploy) ----
# Bu bo'lim LOKAL ishlashda bo'sh qoladi. To'ldirilishi bilan tizim "public
# rejim" ga o'tadi va zaif sozlamalar bilan umuman ishga tushmaydi
# (tekshirish: python manage.py check-deploy).
#
# Saytning tashqi manzili. Faqat https.
PUBLIC_BASE_URL=
# Telegram webhook uchun maxfiy kalit. Yasash: python manage.py secret
WEBHOOK_SECRET=
# Serverless muhitda (Vercel) false qo'yiladi — jadvallar bir marta lokal
# kompyuterdan yaratiladi: DATABASE_URL=... python manage.py init
AUTO_CREATE_TABLES=true
